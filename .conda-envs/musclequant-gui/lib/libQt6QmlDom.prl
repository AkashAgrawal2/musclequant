QMAKE_PRL_TARGET = libQt6QmlDom.a
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.9.2
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/libQt6QmlToolingSettings.a $$[QT_INSTALL_LIBS]/libQt6QmlCompiler.dylib $$[QT_INSTALL_LIBS]/libQt6Qml.dylib $$[QT_INSTALL_LIBS]/libQt6Network.dylib $$[QT_INSTALL_LIBS]/libQt6Core.dylib -framework IOKit -framework DiskArbitration -framework UniformTypeIdentifiers
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/libQt6QmlToolingSettings.a;$$[QT_INSTALL_LIBS]/libQt6QmlCompiler.dylib;$$[QT_INSTALL_LIBS]/libQt6Qml.dylib;$$[QT_INSTALL_LIBS]/libQt6Network.dylib;$$[QT_INSTALL_LIBS]/libQt6Core.dylib;-framework IOKit;-framework DiskArbitration;-framework UniformTypeIdentifiers
