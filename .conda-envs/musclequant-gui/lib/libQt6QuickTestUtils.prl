QMAKE_PRL_TARGET = libQt6QuickTestUtils.a
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.9.2
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/libQt6Quick.dylib $$[QT_INSTALL_LIBS]/libQt6QmlMeta.dylib $$[QT_INSTALL_LIBS]/libQt6QmlWorkerScript.dylib $$[QT_INSTALL_LIBS]/libQt6QmlModels.dylib $$[QT_INSTALL_LIBS]/libQt6OpenGL.dylib $$[QT_INSTALL_LIBS]/libQt6Gui.dylib -framework OpenGL -framework ImageIO -framework Metal $$[QT_INSTALL_LIBS]/libQt6Qml.dylib $$[QT_INSTALL_LIBS]/libQt6Network.dylib $$[QT_INSTALL_LIBS]/libQt6QuickTest.dylib $$[QT_INSTALL_LIBS]/libQt6Test.dylib $$[QT_INSTALL_LIBS]/libQt6Core.dylib -framework DiskArbitration -framework UniformTypeIdentifiers -framework Security -framework AppKit -framework ApplicationServices -framework Foundation -framework IOKit
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/libQt6Quick.dylib;$$[QT_INSTALL_LIBS]/libQt6QmlMeta.dylib;$$[QT_INSTALL_LIBS]/libQt6QmlWorkerScript.dylib;$$[QT_INSTALL_LIBS]/libQt6QmlModels.dylib;$$[QT_INSTALL_LIBS]/libQt6OpenGL.dylib;$$[QT_INSTALL_LIBS]/libQt6Gui.dylib;-framework OpenGL;-framework ImageIO;-framework Metal;$$[QT_INSTALL_LIBS]/libQt6Qml.dylib;$$[QT_INSTALL_LIBS]/libQt6Network.dylib;$$[QT_INSTALL_LIBS]/libQt6QuickTest.dylib;$$[QT_INSTALL_LIBS]/libQt6Test.dylib;$$[QT_INSTALL_LIBS]/libQt6Core.dylib;-framework DiskArbitration;-framework UniformTypeIdentifiers;-framework Security;-framework AppKit;-framework ApplicationServices;-framework Foundation;-framework IOKit
