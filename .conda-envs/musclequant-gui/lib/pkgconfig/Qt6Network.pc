prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
bindir=${prefix}/lib/qt6/bin
libexecdir=${prefix}/lib/qt6
libdir=${prefix}/lib
includedir=${prefix}/include/qt6

Name: Qt6 Network
Description: Qt Network module
Version: 6.9.2
Libs: -L${libdir} -lQt6Network
Cflags: -I${includedir}/QtNetwork -I${includedir} -DQT_NETWORK_LIB
Requires: Qt6Core
