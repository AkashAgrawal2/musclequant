prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
bindir=${prefix}/lib/qt6/bin
libexecdir=${prefix}/lib/qt6
libdir=${prefix}/lib
includedir=${prefix}/include/qt6

Name: Qt6 UiTools
Description: Qt UiTools module
Version: 6.9.2
Libs: -L${libdir} -lQt6UiTools
Cflags: -I${includedir}/QtUiTools -I${includedir} -DQT_UITOOLS_LIB
Requires: Qt6Core Qt6Gui Qt6Widgets Qt6OpenGLWidgets
