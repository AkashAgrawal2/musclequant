prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
bindir=${prefix}/lib/qt6/bin
libexecdir=${prefix}/lib/qt6
libdir=${prefix}/lib
includedir=${prefix}/include/qt6

Name: Qt6 Qml
Description: Qt Qml module
Version: 6.9.2
Libs: -L${libdir} -lQt6Qml
Cflags: -I${includedir}/QtQml -I${includedir} -DQT_QML_LIB
Requires: Qt6Core Qt6QmlIntegration Qt6Network
