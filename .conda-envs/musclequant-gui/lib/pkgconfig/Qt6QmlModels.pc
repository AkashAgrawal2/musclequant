prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
bindir=${prefix}/lib/qt6/bin
libexecdir=${prefix}/lib/qt6
libdir=${prefix}/lib
includedir=${prefix}/include/qt6

Name: Qt6 QmlModels
Description: Qt QmlModels module
Version: 6.9.2
Libs: -L${libdir} -lQt6QmlModels
Cflags: -I${includedir}/QtQmlModels -I${includedir} -DQT_QMLMODELS_LIB
Requires: Qt6Core Qt6Qml
