prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
bindir=${prefix}/lib/qt6/bin
libexecdir=${prefix}/lib/qt6
libdir=${prefix}/lib
includedir=${prefix}/include/qt6

Name: Qt6 OpenGL
Description: Qt OpenGL module
Version: 6.9.2
Libs: -L${libdir} -lQt6OpenGL
Cflags: -I${includedir}/QtOpenGL -I${includedir} -DQT_OPENGL_LIB
Requires: Qt6Core Qt6Gui
