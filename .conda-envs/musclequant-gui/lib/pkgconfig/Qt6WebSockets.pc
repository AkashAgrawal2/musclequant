prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
bindir=${prefix}/lib/qt6/bin
libexecdir=${prefix}/lib/qt6
libdir=${prefix}/lib
includedir=${prefix}/include/qt6

Name: Qt6 WebSockets
Description: Qt WebSockets module
Version: 6.9.2
Libs: -L${libdir} -lQt6WebSockets
Cflags: -I${includedir}/QtWebSockets -I${includedir} -DQT_WEBSOCKETS_LIB
Requires: Qt6Core Qt6Network
