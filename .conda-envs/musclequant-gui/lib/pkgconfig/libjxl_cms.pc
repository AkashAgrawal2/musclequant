prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libjxl_cms
Description: CMS support library for libjxl
Version: 0.11.1
Requires.private: 
Libs: -L${libdir} -ljxl_cms 
Libs.private: -lm -lc++
Cflags: -I${includedir}
Cflags.private: -DJXL_CMS_STATIC_DEFINE
