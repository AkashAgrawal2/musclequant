prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
libdir=/Users/akashagr/musclequant/.conda-envs/musclequant-gui/lib
includedir=/Users/akashagr/musclequant/.conda-envs/musclequant-gui/include

Name: absl_periodic_sampler
Description: Abseil periodic_sampler library
URL: https://abseil.io/
Version: 20240116
Requires: absl_core_headers = 20240116, absl_exponential_biased = 20240116
Libs: -L${libdir}  -labsl_periodic_sampler 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -DNOMINMAX
