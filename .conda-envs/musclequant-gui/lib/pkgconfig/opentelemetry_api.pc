prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry API
Description: A header-only library to support instrumentation with OpenTelemetry.
Requires: absl_bad_variant_access absl_any absl_base absl_bits absl_city
Version: 1.16.1

Libs: -L${libdir} 
Cflags: -I${includedir}  -DOPENTELEMETRY_DEPRECATED_SDK_FACTORY -DHAVE_ABSEIL -DOPENTELEMETRY_ABI_VERSION_NO=1
