prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
bindir=${prefix}/lib/qt6/bin
libexecdir=${prefix}/lib/qt6
libdir=${prefix}/lib
includedir=${prefix}/include/qt6

Name: Qt6 Concurrent
Description: Qt Concurrent module
Version: 6.9.2
Libs: -L${libdir} -lQt6Concurrent
Cflags: -I${includedir}/QtConcurrent -I${includedir} -DQT_CONCURRENT_LIB
Requires: Qt6Core
