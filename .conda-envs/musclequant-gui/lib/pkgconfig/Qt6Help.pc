prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
bindir=${prefix}/lib/qt6/bin
libexecdir=${prefix}/lib/qt6
libdir=${prefix}/lib
includedir=${prefix}/include/qt6

Name: Qt6 Help
Description: Qt Help module
Version: 6.9.2
Libs: -L${libdir} -lQt6Help
Cflags: -I${includedir}/QtHelp -I${includedir} -DQT_HELP_LIB
Requires: Qt6Core Qt6Gui Qt6Sql Qt6Widgets
