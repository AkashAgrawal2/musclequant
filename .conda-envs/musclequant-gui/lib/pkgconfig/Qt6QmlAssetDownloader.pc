prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
bindir=${prefix}/lib/qt6/bin
libexecdir=${prefix}/lib/qt6
libdir=${prefix}/lib
includedir=${prefix}/include/qt6

Name: Qt6 QmlAssetDownloader
Description: Qt QmlAssetDownloader module
Version: 6.9.2
Libs: -L${libdir} -lQt6QmlAssetDownloader
Cflags: -I${includedir}/QtQmlAssetDownloader -I${includedir} -DQT_QMLASSETDOWNLOADER_LIB
Requires: Qt6Qml
