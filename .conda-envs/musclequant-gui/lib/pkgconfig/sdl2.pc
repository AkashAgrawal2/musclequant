# sdl2_compat pkg-config source file

prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
libdir=/Users/akashagr/musclequant/.conda-envs/musclequant-gui/lib
includedir=/Users/akashagr/musclequant/.conda-envs/musclequant-gui/include

Name: sdl2_compat
Description: An SDL2 compatibility layer that uses SDL3 behind the scenes.
Version: 2.32.56
Provides: sdl2 = 2.32.56
Libs: -L${libdir}  -lSDL2main -lSDL2 -Wl,-framework,Cocoa
#Libs.private: 
Cflags: -I${includedir} -I${includedir}/SDL2 -D_THREAD_SAFE
