prefix=/Users/akashagr/musclequant/.conda-envs/musclequant-gui
exec_prefix=${prefix}
bindir=${prefix}/lib/qt6/bin
libexecdir=${prefix}/lib/qt6
libdir=${prefix}/lib
includedir=${prefix}/include/qt6

Name: Qt6 Gui
Description: Qt Gui module
Version: 6.9.2
Libs: -L${libdir} -lQt6Gui
Cflags: -I${includedir}/QtGui -I${includedir} -DQT_GUI_LIB
Requires: Qt6Core
