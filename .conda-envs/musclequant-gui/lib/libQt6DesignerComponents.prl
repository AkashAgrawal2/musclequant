QMAKE_PRL_TARGET = libQt6DesignerComponents.dylib
QMAKE_PRL_CONFIG = shared
QMAKE_PRL_VERSION = 6.9.2
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/libQt6Designer.dylib $$[QT_INSTALL_LIBS]/libQt6OpenGLWidgets.dylib $$[QT_INSTALL_LIBS]/libQt6OpenGL.dylib $$[QT_INSTALL_LIBS]/libQt6Widgets.dylib $$[QT_INSTALL_LIBS]/libQt6Gui.dylib -framework AppKit -framework OpenGL -framework ImageIO -framework Metal $$[QT_INSTALL_LIBS]/libQt6Xml.dylib $$[QT_INSTALL_LIBS]/libQt6Core.dylib -framework IOKit -framework DiskArbitration -framework UniformTypeIdentifiers
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/libQt6Designer.dylib;$$[QT_INSTALL_LIBS]/libQt6OpenGLWidgets.dylib;$$[QT_INSTALL_LIBS]/libQt6OpenGL.dylib;$$[QT_INSTALL_LIBS]/libQt6Widgets.dylib;$$[QT_INSTALL_LIBS]/libQt6Gui.dylib;-framework AppKit;-framework OpenGL;-framework ImageIO;-framework Metal;$$[QT_INSTALL_LIBS]/libQt6Xml.dylib;$$[QT_INSTALL_LIBS]/libQt6Core.dylib;-framework IOKit;-framework DiskArbitration;-framework UniformTypeIdentifiers
